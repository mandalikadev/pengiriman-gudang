# Variabel lingkungan untuk test (CI memuatnya otomatis; vitest memuatnya jika belum diset).
# Bukan rahasia asli.
DATABASE_URL=postgres://mandalika:mandalika@localhost:5432/mandalika_test
BETTER_AUTH_SECRET=rahasia-khusus-test-bukan-untuk-produksi-0123456789
BETTER_AUTH_URL=http://localhost:3000
# Storage S3 untuk unggahan workbook (MinIO di CI dan lokal).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mandalika-test
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
