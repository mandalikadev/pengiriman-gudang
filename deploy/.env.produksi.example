# Variabel lingkungan produksi (T130, docs/DEPLOY.md). bootstrap-vps.sh menyalin berkas ini ke /opt/drp/.env sekali
# (tidak pernah menimpa yang sudah ada) dan mengisi otomatis nilai bertanda [otomatis] dengan `openssl rand`.
# Jangan commit /opt/drp/.env. Nilai bertanda [pemilik] diisi pemilik sebelum deploy pertama.
# Semua nilai ditulis apa adanya, tanpa tanda kutip.

# PostgreSQL di dalam stack (tanpa port ke host). DATABASE_URL untuk aplikasi disusun compose.prod.yml dari tiga
# nilai ini, jadi sandi hanya boleh huruf dan angka.
POSTGRES_USER=drp
POSTGRES_DB=drp
# [otomatis] heksadesimal acak.
POSTGRES_PASSWORD=

# Better Auth. Alamat publik aplikasi; harus sama dengan domain di deploy/drp.caddy.
BETTER_AUTH_URL=https://drp.mandalika.web.id
# [otomatis] rahasia acak minimal 32 karakter. Mengubahnya membuat semua sesi masuk tidak berlaku.
BETTER_AUTH_SECRET=

# [pemilik] Admin pertama, dibuat oleh langkah migrasi pada deploy pertama. Langkah itu berjalan setiap deploy dan
# idempoten (email yang sudah terdaftar tidak diubah), tetapi tetap memeriksa ketiga nilai ini, jadi jangan dikosongkan.
# Sandi minimal 8 karakter.
ADMIN_AWAL_NAMA=
ADMIN_AWAL_EMAIL=
ADMIN_AWAL_SANDI=

# Storage S3 (MinIO di dalam stack). Browser mengunggah workbook langsung ke S3_ENDPOINT lewat presigned URL; proxy
# meneruskan https://drp.mandalika.web.id/<S3_BUCKET>/... ke MinIO.
S3_ENDPOINT=https://drp.mandalika.web.id
S3_REGION=us-east-1
# Harus sama dengan path bucket di deploy/drp.caddy. Bucket dibuat otomatis oleh worker.
S3_BUCKET=mandalika
# [otomatis] Juga dipakai sebagai kredensial root MinIO.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# [pemilik] Backup luar VPS ke Google Drive (T131, layanan backup-luar, docs/DEPLOY.md "Backup ke Google Drive").
# Setiap hari, 1 jam setelah pg_dump, dump terbaru disalin ke <folder>/drp/database/ (dump lebih tua dari 30 hari
# dihapus) dan isi bucket S3_BUCKET disinkronkan ke <folder>/drp/workbook/.
# Autentikasi memakai kunci JSON service account Google di /opt/drp/rahasia/google-backup.json (tidak di repo dan
# tidak di berkas ini). Selama keduanya kosong, backup-luar hanya mencatat bahwa backup luar belum dikonfigurasi.
# ID Shared Drive: bagian terakhir alamat Shared Drive di browser,
# https://drive.google.com/drive/folders/<ID>.
BACKUP_GDRIVE_DRIVE_ID=
# ID folder tujuan di dalam Shared Drive itu (cara melihatnya sama: buka foldernya, ambil bagian terakhir alamat).
BACKUP_GDRIVE_FOLDER_ID=
