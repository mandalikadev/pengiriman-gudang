# Salin ke .env untuk pengembangan lokal. Nilai di bawah cocok dengan docker-compose.yml.
DATABASE_URL=postgres://mandalika:mandalika@localhost:5432/mandalika

# Better Auth. Rahasia minimal 32 karakter; buat dengan `openssl rand -base64 32`.
BETTER_AUTH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# Admin pertama, dipakai sekali oleh `pnpm db:seed-admin`.
ADMIN_AWAL_NAMA=Admin
ADMIN_AWAL_EMAIL=admin@example.com
ADMIN_AWAL_SANDI=ganti-kata-sandi-ini
